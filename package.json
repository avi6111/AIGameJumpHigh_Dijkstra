{
  "name": "vrm-game-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A beginner-friendly Three.js (WebGPU) starter template for building games with VRM avatars",
  "keywords": [
    "three",
    "threejs",
    "vrm",
    "webgpu",
    "game",
    "template",
    "character-controller"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
