    "vue": "^3.4.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "gh-pages": "^6.3.0",
    "typescript": "^5.8.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
